; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HealingWithout"
config/tags=PackedStringArray("adult_situations", "gore", "nudity", "violence")
run/main_scene="res://MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"
boot_splash+/background/animation=2
boot_splash+/logo/text=""

[audio]

buses/default_bus_layout="uid://b3oj24ea5ebml"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
GameState="*uid://dlgv3mdonj08l"
BootSplashPlus="*uid://dokddwtktku65"
SubsystemBoot="*res://addons/FoundationGameFramework/editor/SubsystemBootAutoload.gd"
HeraGameInspector="*uid://c4ug7a211oav8"

[dialogic]

directories/dch_directory={
"Mother": "res://Mother.dch",
"Narrator": "res://Narrator.dch",
"Sarah": "res://Characters/sarah.dch"
}
directories/dtl_directory={
"first-big-choice": "res://first-big-choice.dtl",
"sarahtimeline": "res://sarahtimeline.dtl",
"timeline": "res://timeline.dtl"
}
layout/style_directory={
"Mom": "res://addons/dialogic/Modules/DefaultLayoutParts/Layer_VN_Textbox/Mom.tres",
"narrator_style": "res://Characters/narrator_style.tres",
"sarah": "res://addons/dialogic/Modules/DefaultLayoutParts/Layer_VN_Textbox/sarah.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://Characters/narrator_style.tres", "res://addons/dialogic/Modules/DefaultLayoutParts/Layer_VN_Textbox/sarah.tres", "res://addons/dialogic/Modules/DefaultLayoutParts/Layer_VN_Textbox/Mom.tres"]
layout/default_style=""
variables={
"GameState": {
"SanityLevel": "",
"both_together_points": 0,
"mother_alone_points": 0,
"sarah_alone_points_": 0
}
}
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0.0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"React": {
"audio_bus": "Inside",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
},
"music": {
"audio_bus": "Music",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
},
"otherroom": {
"audio_bus": "Voice",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
},
"voice": {
"audio_bus": "Voice",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
audio/type_sound_bus="Voice"
glossary/glossary_files=["uid://bg84v70m5y68y"]
text/autocolor_names=true
history/simple_history_enabled=false
history/simple_history_save=false
history/full_history_enabled=false
history/full_history_save=false
history/visited_event_history_enabled=false
history/save_on_autosave=false
history/save_on_save=false
layout/end_behaviour=1
extensions_folder="res://addons/dialogic_additions"
text/input_action="dialogic_default_action"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/ExtensionResolver/plugin.cfg", "res://addons/FoundationGameFramework/plugin.cfg", "res://addons/FoundationGameplayTags/plugin.cfg", "res://addons/GMPShared/menu/plugin.cfg", "res://addons/Quick-Add-Menu/plugin.cfg", "res://addons/QuickAudioPreview/plugin.cfg", "res://addons/SceneBuilder/addons/scene_builder/plugin.cfg", "res://addons/SharePlugin/plugin.cfg", "res://addons/asset_placer_with_physics/plugin.cfg", "res://addons/boot_splash_plus/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/footstepper/plugin.cfg", "res://addons/godot-state-machine-1.0.0/addons/state_machine/plugin.cfg", "res://addons/godot_3d_cursor/plugin.cfg", "res://addons/hera_agent_godot/plugin.cfg", "res://addons/nodes_plus/plugin.cfg")

