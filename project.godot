AmbientParser="*uid://dcdrqnwmpgvk4"
AmbientFileHandler="*uid://dnh8sqjyu74hs"
AmbientMaterialMaker="*uid://nig0lamfd3mv"
NoteValue="*uid://gdms0yobdmba"
Inventory="*res://scripts/Inventory.gd"
InventoryUI="*res://scenes/InventoryUI.tscn"

[dialogic]

