choices/hotkey_behaviour=1
directories/dtl_directory={
"first-big-choice": "res://dilogic/timelines/first-big-choice.dtl",
"sarah_door_locked": "res://dilogic/timelines/sarah_door_locked.dtl",
"tv_story": "res://dilogic/timelines/tv_story.dtl"
