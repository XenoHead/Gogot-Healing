[editor_plugins]

enabled=PackedStringArray("res://addons/ExtensionResolver/plugin.cfg", "res://addons/PolyHavenImport/plugin.cfg", "res://addons/SimpleSampler/plugin.cfg", "res://addons/Swift_Inventory/plugin.cfg", "res://addons/ambientcg/plugin.cfg", "res://addons/asset_browser/plugin.cfg", "res://addons/asset_placer_with_physics/plugin.cfg", "res://addons/boot_splash_plus/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/easyik/plugin.cfg", "res://addons/footstepper/plugin.cfg", "res://addons/godot_mcp_server/plugin.cfg", "res://addons/nodes_plus/plugin.cfg", "res://addons/state_machine/plugin.cfg")

