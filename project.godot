"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
audio/type_sound_bus="Master"
glossary/glossary_files=[]
text/autocolor_names=true
history/simple_history_enabled=true
history/simple_history_save=false
history/full_history_enabled=false
history/full_history_save=false
history/visited_event_history_enabled=false
history/save_on_autosave=false
history/save_on_save=true
layout/end_behaviour=1
extensions_folder="res://addons/dialogic/custom_extensions"
